{
  "title": "AGENT WATCH | Compliance Lab",
  "description": "Ocho casos por sesión: operaciones permitidas, rechazos verificados y hallazgos con evidencia. Controles del laboratorio; el texto requiere revisión humana.",
  "inputs": {
    "input_time": {
      "type": "input.timerange",
      "title": "Periodo",
      "options": {
        "token": "global_time",
        "defaultValue": "-24h@h,now"
      }
    },
    "input_agent": {
      "type": "input.dropdown",
      "title": "Agente",
      "options": {
        "token": "agent",
        "defaultValue": "*",
        "items": [
          {
            "label": "Todos",
            "value": "*"
          },
          {
            "label": "Finanzas",
            "value": "finanzas"
          },
          {
            "label": "Soporte",
            "value": "soporte"
          },
          {
            "label": "RR. HH.",
            "value": "rrhh"
          },
          {
            "label": "Compras",
            "value": "compras"
          }
        ]
      }
    },
    "input_run": {
      "type": "input.text",
      "title": "Run ID · * = todas",
      "options": {
        "token": "run",
        "defaultValue": "*"
      }
    }
  },
  "defaults": {
    "visualizations": {
      "global": {
        "showProgressBar": false,
        "showLastUpdated": false
      }
    },
    "dataSources": {
      "ds.search": {
        "options": {
          "queryParameters": {
            "earliest": "$global_time.earliest$",
            "latest": "$global_time.latest$"
          }
        }
      }
    }
  },
